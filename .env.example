# ---------------------------------------------------------------
# PreferenceAI environment variables
#
# Copy this file to `.env` and fill in real values:
#     Copy-Item .env.example .env        (PowerShell)
#
# `.env` is git-ignored. This file is committed so others know
# WHICH variables exist — it must never contain real secrets.
#
# Rule: variables WITHOUT the NEXT_PUBLIC_ prefix exist only on
# the server. Never prefix a secret with NEXT_PUBLIC_ — that
# would bundle it into JavaScript sent to every browser.
# ---------------------------------------------------------------

# --- Database (Phase 3) ----------------------------------------
# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://preferenceai:preferenceai@localhost:5432/preferenceai"

# --- OpenAI (Phase 4) ------------------------------------------
# Create at https://platform.openai.com/api-keys — server-side only.
OPENAI_API_KEY="sk-replace-me"
# Model name is configuration, not code. Chosen together in Phase 4.
OPENAI_MODEL="replace-me"
